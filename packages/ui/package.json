{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UI components for AI Analytics Dashboard",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "typescript": "*",
    "tsup": "*",
    "vitest": ">=4.1.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./types/*": "./src/types/*.ts"
  }
}